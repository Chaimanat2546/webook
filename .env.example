NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Required for username sign-in lookup and validated Customer Master writes.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side only. Exact 32-byte canonical base64url KEK and its positive SQL-integer version.
CENTRAL_USER_MANAGER_TOKEN_KEK=
CENTRAL_USER_MANAGER_TOKEN_KEK_VERSION=1
# Configure this pair only while rewrapping rows from the previous KEK.
CENTRAL_USER_MANAGER_TOKEN_KEK_PREVIOUS=
CENTRAL_USER_MANAGER_TOKEN_KEK_PREVIOUS_VERSION=

# Offline operator CLI only. Prefer a fine-grained token with auth_config_read.
# Do not expose these through NEXT_PUBLIC_* or commit real values.
SUPABASE_ACCESS_TOKEN=
# Target-only Wrangler secret/deploy credential; never exposed to the target build.
CLOUDFLARE_API_TOKEN=

# Server-side canonical HTTPS origin used in public quotation QR codes.
# Leave empty to render public quotations without a QR code.
QUOTATION_PUBLIC_ORIGIN=

# Shared media Worker/R2 for advertisement images and new managed house images.
# For quotation payment assets, use a bare HTTPS origin here (no path, query, or fragment).
ADVERTISEMENT_IMAGE_WORKER_URL=
ADVERTISEMENT_IMAGE_WORKER_SECRET=

# Legacy AWS/S3 house image delete credentials. Server-side only.
AWS_REGION=
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
